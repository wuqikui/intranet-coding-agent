# ============================================================
# 内网离线 AI Coding Agent 系统 - 环境配置
# 复制为 .env 并按实际环境填写
# ============================================================

# --- 服务端口 ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
INFERENCE_PORT=8001

# --- 数据库 (SQLite) ---
DATABASE_URL=sqlite:///./data/app.db
AUDIT_DB_PATH=./data/audit.db

# --- 模型配置 ---
# 推理后端: vllm | llama_cpp | mock
INFERENCE_BACKEND=mock
# 模型名称 (vLLM/llama-server 中的模型标识)
MODEL_NAME=qwen2.5-coder-32b-instruct
# 模型权重路径 (离线导入后的内网路径)
MODEL_PATH=/models/qwen2.5-coder-32b
# 量化方式: awq | gptq | fp8 | q4 | q5 | q8
QUANTIZATION=q4
# vLLM tensor parallel 大小 (GPU 数量)
TENSOR_PARALLEL_SIZE=1
# 最大上下文长度
MAX_MODEL_LEN=32768
# GPU 显存利用率上限 (0-1)
GPU_MEMORY_UTILIZATION=0.90

# --- 显存自适应 ---
# 单卡推荐策略: 32B_Q4 或 14B_Q8
SINGLE_CARD_STRATEGY=32b_q4
# 多卡推荐策略: 70B_Q4 或更高
MULTI_CARD_STRATEGY=70b_q4
# KV cache 预留比例 (0-1)
KV_CACHE_RESERVE=0.15
# 最大并发请求数 (按显存自动计算, 0=自动)
MAX_CONCURRENT_REQUESTS=0

# --- 知识库配置 ---
# 四通道独立持久化路径
KB_BUSINESS_PATH=./data/kb/business
KB_CODE_PATH=./data/kb/code
KB_BUILDOPS_PATH=./data/kb/buildops
KB_DATAAPI_PATH=./data/kb/dataapi
# Chroma 持久化目录
CHROMA_PERSIST_PATH=./data/chroma
# 符号图谱 SQLite 路径 (代码库)
SYMBOL_GRAPH_PATH=./data/symbols.db
# Embedding 模型路径 (离线导入)
EMBEDDING_MODEL_PATH=/models/embeddings/bge-large-zh
# Embedding 维度
EMBEDDING_DIM=1024

# --- 沙箱配置 ---
# 沙箱模式: docker | rootless | process
SANDBOX_MODE=process
# 沙箱镜像 (docker 模式)
SANDBOX_IMAGE=coding-sandbox:latest
# 工作区根目录 (用户项目存放)
WORKSPACE_ROOT=./data/workspace
# 最大修复轮次 (工程循环)
MAX_FIX_ROUNDS=5

# --- 鉴权配置 ---
# JWT 密钥 (生产环境务必修改)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# 认证模式: local | ldap | ad
AUTH_MODE=local
# LDAP/AD 配置 (AUTH_MODE=ldap/ad 时填写)
LDAP_URL=ldap://ldap.internal:389
LDAP_BASE_DN=dc=company,dc=com
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})

# --- 出网维护模式 ---
# 默认关闭; 管理员通过 API 临时开启
MAINTENANCE_MODE=false
# 离线模型库路径
MODEL_REPO_PATH=/models
# 离线包仓库路径
PACKAGE_REPO_PATH=/packages

# --- 审计配置 ---
# 审计日志目录 (只读追加)
AUDIT_LOG_PATH=./data/audit
# 哈希链种子
AUDIT_HASH_SEED=genesis-block-seed

# --- 前端配置 ---
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# --- 日志 ---
LOG_LEVEL=INFO
